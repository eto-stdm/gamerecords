<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные стили с использованием Open Sans и Pantone цветов -->
    <!-- MainWindow -->
    <Style x:Key="LogoMain" TargetType="Image">
        <Setter Property="Source" Value="/Images/speedrun.png"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Margin" Value="50,0"/>
    </Style>
    <!-- Основной текст с Open Sans -->
    <Style x:Key="RegularTextMain" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/OpenSans"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- ClockMain -->
    <Style x:Key="ClockMain" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/OpenSans"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <!-- ButtonMenu -->
    <Style x:Key="ButtonMenu" TargetType="Button">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/OpenSans"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Background" Value="#1E84D2"/>
        <Setter Property="BorderBrush" Value="#1E84D2"/>
        <Setter Property="Margin" Value="50,0"/>
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Style.Resources>
    </Style>
    <!-- AdminPanelPage -->
    <Style x:Key="HeaderAdminPanel" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/OpenSans"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    <!-- RegularAdminPanel -->
    <Style x:Key="RegularAdminPanel" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#A0AEC0"/>
        <Setter Property="FontFamily" Value="/Fonts/OpenSans"/>
        <Setter Property="Margin" Value="0,10,10,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- ListBoxAdminPanel -->
    <Style x:Key="ListBoxAdminPanel" TargetType="ListBox">
        <Setter Property="Width" Value="730"/>
        <Setter Property="Height" Value="600"/>
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="BorderBrush" Value="#A0AEC0"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <!-- CatalogPage -->
    <Style x:Key="StackPanelCenteredCatalog" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BorderCatalog" TargetType="Border">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="#233A3D"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <!-- ButtonRandomGameCatalog -->
    <Style x:Key="ButtonRandomGameCatalog" TargetType="Button">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Content" Value="Случайная игра"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/OpenSans"/>
        <Setter Property="Background" Value="#1E84D2"/>
        <Setter Property="BorderBrush" Value="#1E84D2"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    <!-- SignInPage / SignUpPage -->
    <Style x:Key="LogoSignIn" TargetType="Image">
        <Setter Property="Source" Value="/Images/speedrun.png"/>
        <Setter Property="Width" Value="200"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    <Style x:Key="HeaderSignIn" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/OpenSans"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="10, 10, 10, 10"/>
    </Style>
    <!-- RegularTextSignIn -->
    <Style x:Key="RegularTextSignIn" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#A0AEC0"/>
        <Setter Property="Margin" Value="10,0,0,5"/>
    </Style>
    <!-- TextBoxSignIn -->
    <Style x:Key="TextBoxSignIn" TargetType="TextBox">
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#A0AEC0"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="10,0,10,10"/>
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Style.Resources>
    </Style>
    <!-- ButtonSignIn -->
    <Style x:Key="ButtonSignIn" TargetType="Button">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/OpenSans"/>
        <Setter Property="Background" Value="#1E84D2"/>
        <Setter Property="BorderBrush" Value="#1E84D2"/>
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Style.Resources>
    </Style>
    <!-- Window Style -->
    <Style TargetType="Window" x:Key="MyWindowStyle">
        <Setter Property="Background" Value="#1E293B"/>
    </Style>
</ResourceDictionary>