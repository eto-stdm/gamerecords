<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- MainWindow -->
    <Style x:Key="LogoMain" TargetType="Image">
        <Setter Property="Source" Value="/Images/speedrun.png"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Margin" Value="50,0"/>
    </Style>

    <Style x:Key="RegularTextMain" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/#Inter Medium"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ClockMain" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/#Inter Medium"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style x:Key="ButtonMenu" TargetType="Button">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Background" Value="#188f6e"/>
        <Setter Property="BorderBrush" Value="#188f6e" />
        <Setter Property="Margin" Value="50,0"/>
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="ComboBoxTheme" TargetType="ComboBox">
        <Setter Property="Background" Value="#111618"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#188f6e"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,10,10,10"/>

        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="ButtonExit" TargetType="Button">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Background" Value="Red"/>
        <Setter Property="BorderBrush" Value="Red" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Style.Resources>
    </Style>
    <!-- MainWindow -->

    

    <!-- AdminPanelPage -->
    <Style x:Key="HeaderAdminPanel" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/#Inter Medium"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    
    <Style x:Key="RegularAdminPanel" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="/Fonts/#Inter Medium"/>
        <Setter Property="Margin" Value="0,10,10,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ListBoxAdminPanel" TargetType="ListBox">
        <Setter Property="Width" Value="730"/>
        <Setter Property="Height" Value="600"/>
        <Setter Property="Background" Value="#233a3d"/>
        <Setter Property="BorderBrush" Value="#233a3d"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="GridCenteredAdminPanel" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="GridHorizontalAdminPanel" TargetType="Grid">
        <Setter Property="Width" Value="700"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="BorderUsual" TargetType="Border">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="#233a3d"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="StackPanelCentered" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <!-- AdminPanelPage -->



    <!-- CatalogPage -->
    <!-- Стиль для StackPanel центрального выравнивания -->
    <Style x:Key="StackPanelCenteredCatalog" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Border с фоном и округлением -->
    <Style x:Key="BorderCatalog" TargetType="Border">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="#233a3d"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Стиль для Grid с центрированием элементов -->
    <Style x:Key="GridCenteredCatalog" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- Стиль для ComboBox (Платформа) -->
    <Style x:Key="ComboBoxPlatformCatalog" TargetType="ComboBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Стиль для ComboBox (Сортировка) -->
    <Style x:Key="ComboBoxSortByCatalog" TargetType="ComboBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Стиль для Button (Случайная игра) -->
    <Style x:Key="ButtonRandomGameCatalog" TargetType="Button">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Content" Value="Случайная игра"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Стиль для ListBox -->
    <Style x:Key="ListBoxGamesCatalog" TargetType="ListBox">
        <Setter Property="Width" Value="730"/>
        <Setter Property="Height" Value="600"/>
        <Setter Property="Background" Value="#233a3d"/>
        <Setter Property="BorderBrush" Value="#233a3d"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
    </Style>

    <!-- Стиль для DataTemplate в ListBox -->
    <DataTemplate x:Key="GameItemTemplate">
        <Grid Width="100" Height="210" Margin="5">
            <WrapPanel>
                <Border Width="100" Height="150">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding image}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="{Binding name}" Foreground="White" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </WrapPanel>
        </Grid>
    </DataTemplate>

    <!-- Стиль для Grid внутри ListBox -->
    <Style x:Key="GameItemGridCatalog" TargetType="Grid">
        <Setter Property="Width" Value="730"/>
        <Setter Property="Height" Value="210"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    <!-- CatalogPage -->

    
    
    <!-- GamePage -->
    
    <!-- GamePage -->

    
    <!-- SignInPage / SignUpPage -->
    <Style x:Key="LogoSignIn" TargetType="Image">
        <Setter Property="Source" Value="/Images/speedrun.png"/>
        <Setter Property="Width" Value="200"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <Style x:Key="HeaderSignIn" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontFamily" Value="/Fonts/#Inter Extra Bold"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="10, 10, 10, 10"/>
    </Style>

    <Style x:Key="RegularTextSignIn" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#aeb3ba"/>
        <Setter Property="Margin" Value="10,0,0,5"/>
    </Style>

    <Style x:Key="HyperlinkSignIn" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="#188f6e"/>
        <Setter Property="TextDecorations" Value="None"/>
    </Style>

    <Style x:Key="TextBoxSignIn" TargetType="TextBox">
        <Setter Property="Background" Value="#111618"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#188f6e"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="10,0,10,10"/>
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="PasswordSignIn" TargetType="PasswordBox">
        <Setter Property="Background" Value="#111618"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="10,0,10,10"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border CornerRadius="5" BorderThickness="1" BorderBrush="#188f6e" Background="#111618">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonSignIn" TargetType="Button">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#188f6e"/>
        <Setter Property="FontFamily" Value="/Fonts/#Inter Medium"/>
        <Setter Property="BorderBrush" Value="#188f6e" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5" />
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="ComboBoxSignUp" TargetType="ComboBox">
        <Setter Property="Background" Value="#111618"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#188f6e"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="10,0,10,10"/>

        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5" />
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="ComboItemSignUp" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#111618"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#188f6e"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>








    <Style TargetType="Window" x:Key="MyWindowStyle">
        <Setter Property="Background" Value="#111618"/>
    </Style>
</ResourceDictionary>