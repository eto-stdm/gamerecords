<Page x:Class="gamerecords.Pages.AdminPanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPanelPage">

    <StackPanel  HorizontalAlignment="Center">
        <TextBlock Text="Панель администратора"/>
        <TextBlock Text="Проверка рекордов"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Padding="10" Background="#233a3d" CornerRadius="10">
                <StackPanel>
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                        <ListBox x:Name="RecordsLB" Width="730" Height="600" Background="#233a3d" BorderBrush="#233a3d" VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="RecordsLB_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="100" Height="210" Margin="5">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding name}" Foreground="White" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        </WrapPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
