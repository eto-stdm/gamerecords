<Page x:Class="gamerecords.Pages.AdminPanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="AdminPanelPage">

    <!--Заголовок-->
    <StackPanel Style="{DynamicResource StackPanelCentered}">
        <TextBlock Text="Панель администратора" Style="{DynamicResource FirstTBAdminPanel}"/>
        <ComboBox x:Name="SelectPageCB" Style="{DynamicResource ComboBoxSignUp}" ItemContainerStyle="{DynamicResource ComboBoxItemBase}" SelectionChanged="SelectPageCB_SelectionChanged"/>

        <!--Список рекордов-->
        <StackPanel x:Name="RecordsSP" Style="{DynamicResource StackPanelCentered}" Visibility="Collapsed">
            <Border Style="{DynamicResource BorderUsual}">
                <StackPanel>
                    <Grid Style="{DynamicResource GridCentered}">
                        <ListBox x:Name="RecordsLB" Style="{DynamicResource ListBoxUsual}" MouseDoubleClick="RecordsLB_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{DynamicResource GridHorizontalAdminPanel}">
                                        <WrapPanel Style="{DynamicResource WrapPanelOrientHor}" ItemHeight="16"  VerticalAlignment="Center" ToolTip="{Binding video, StringFormat=Видео: {0}}">
                                            <TextBlock Text="{Binding Players.nickname, StringFormat=Никнейм: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding GamesCategories.Games.name, StringFormat=Игра: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding GamesCategories.Categories.category, StringFormat=Категория: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding total_time, StringFormat=Время: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding date, StringFormat=Дата: dd.MM.yyyy hh:mm:ss}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding GamesPlatforms.Platforms.platform, StringFormat=Платформа: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                        </WrapPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!--Блок с гайдами-->
        <StackPanel x:Name="GuidesSP" Style="{DynamicResource StackPanelCentered}" Visibility="Collapsed">
            <Border Style="{DynamicResource BorderUsual}">
                <ListBox x:Name="GuidesLB" Style="{DynamicResource ListBoxLeaderGame}" MouseDoubleClick="GuidesLB_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{DynamicResource GridHorizontalAdminPanel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                
                                <WrapPanel Grid.Column="0" Style="{DynamicResource WrapPanelOrientHor}" ItemHeight="16"  VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Games.name, StringFormat=Игра: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                    <TextBlock Text="{Binding title, StringFormat=Название: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                    <TextBlock Text="{Binding Players.nickname, StringFormat=Автор: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                </WrapPanel>

                                <Button Grid.Column="1" Content="Удалить" Style="{DynamicResource ButtonDeleteAdminPanel}" Click="Button_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
