<Page x:Class="gamerecords.Pages.AdminPanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="AdminPanelPage">

    <!--Заголовок-->
    <StackPanel Style="{DynamicResource StackPanelCentered}">
        <TextBlock Text="Панель администратора" Style="{DynamicResource HeaderAdminPanel}"/>
        <TextBlock Text="Проверка рекордов" Style="{DynamicResource HeaderAdminPanel}"/>

        <!--Основная часть-->
        <StackPanel Style="{DynamicResource StackPanelCentered}">
            <Border Style="{DynamicResource BorderUsual}">
                <StackPanel>
                    <Grid Style="{DynamicResource GridCenteredAdminPanel}">
                        <ListBox x:Name="RecordsLB" Style="{DynamicResource ListBoxUsual}" MouseDoubleClick="RecordsLB_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{DynamicResource GridHorizontalAdminPanel}">
                                        <StackPanel Style="{DynamicResource StackPanelCentered}">
                                            <TextBlock Text="{Binding Players.nickname, StringFormat=Никнейм: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding GamesCategories.Games.name, StringFormat=Игра: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding GamesCategories.Categories.category, StringFormat=Категория: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding total_time, StringFormat=Время: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding date, StringFormat=Дата: dd.MM.yyyy hh:mm:ss}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding GamesPlatfoms.Platforms.platform, StringFormat=Платформа: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
