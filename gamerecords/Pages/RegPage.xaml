<Page x:Class="gamerecords.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Вход в систему" Margin="10" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Логин:" Margin="10,0,0,10"/>
            <TextBox x:Name="LoginTB" Width="100" Margin="10,0,10,10"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="RegTB" Content="Регистрация" Margin="10,0,10,10" Width="80" Click="RegTB_Click"/>
            <Button x:Name="LogTB" Content="Вход" Margin="0,0,10,10" Width="80" Click="LogTB_Click"/>
        </StackPanel>
    </StackPanel>
</Page>
