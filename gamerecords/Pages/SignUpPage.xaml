<Page x:Class="gamerecords.Pages.SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignUpPage">

    <StackPanel Style="{DynamicResource StackPanelCentered}">
        <Image Style="{DynamicResource LogoSignIn}"/>
        <Border Style="{DynamicResource BorderUsual}">
            
            <StackPanel>
                
                <!--Заголовок-->
                <TextBlock Text="Создание аккаунта" Style="{DynamicResource HeaderSignIn}"/>

                <!--Логин-->
                <StackPanel Style="{DynamicResource StackPanelCentered}">
                    <TextBlock Text="Логин" Style="{DynamicResource RegularTextSignIn}"/>
                    <TextBox x:Name="LoginTB" Style="{DynamicResource TextBoxSignIn}"/>
                </StackPanel>
                
                <StackPanel Style="{DynamicResource StackPanelCentered}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!--Пароль-->
                        <TextBlock Text="Пароль" Style="{DynamicResource RegularTextSignIn}" Grid.Column="0"/>
                    </Grid>
                    <PasswordBox x:Name="PasswordTB" Style="{DynamicResource PasswordSignIn}"/>
                </StackPanel>

                <!--Страна-->
                <StackPanel Style="{DynamicResource StackPanelCentered}">
                    <TextBlock Text="Страна (опционально)" Style="{DynamicResource RegularTextSignIn}"/>
                    <ComboBox x:Name="CountryTB" Style="{DynamicResource ComboBoxSignUp}" ItemContainerStyle="{DynamicResource ComboItemSignUp}"/>
                </StackPanel>
               
                <TextBlock Text="Показывается как флаг рядом с вашем именем." Style="{DynamicResource RegularTextSignIn}"/>
                <!-- Сделать добавление аватара -->

                <!--Регистрация-->
                <Button x:Name="SignUpBtn" Content="Зарегистрироваться" Style="{DynamicResource ButtonSignIn}" Click="SignUpBtn_Click"/>
                <StackPanel Style="{DynamicResource SPSignIn}">
                    <TextBlock Text="Уже есть аккаунт?" Style="{DynamicResource RegularTextSignIn}"/>
                    <TextBlock Grid.Column="1" Style="{DynamicResource TextNewSignIn}">
                       <Hyperlink x:Name="HyperLinkSignIn" Style="{DynamicResource HyperlinkSignIn}" Click="HyperLinkSignIn_Click">Войти</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
