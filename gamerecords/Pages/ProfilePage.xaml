<Page x:Class="gamerecords.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="ProfilePage">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        
        <!--Заголовок-->
        <TextBlock Text="Профиль" Style="{DynamicResource FirstTBAdminPanel}"/>
        <StackPanel Orientation="Horizontal">
            <Border Style="{DynamicResource BorderUsual}" Width="750">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Image x:Name="ProfileImg" Height="100" Width="100" Margin="10"/>
                        <Button x:Name="AvatarBtn" Content="Изменить аватар" Style="{DynamicResource ButtonAvatarSignUp}" Click="AvatarBtn_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NickNameTB" Text="Никнейм: " Style="{DynamicResource SecondTBAdminPanel}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CountryTB" Text="Страна: " Style="{DynamicResource SecondTBAdminPanel}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="RecordsAmountTB" Text="Кол-во забегов: " Style="{DynamicResource SecondTBAdminPanel}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecordsOKTB" Text="Верифицированны: " Style="{DynamicResource SecondTBAdminPanel}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecordsNoTB" Text="Не верифицированны: " Style="{DynamicResource SecondTBAdminPanel}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <TextBlock Text="Мои рекорды" Style="{DynamicResource SecondTBAdminPanel}"/>

            <!--Вывод рекордов пользователя-->
        <StackPanel Style="{DynamicResource StackPanelCentered}">
            <Border Style="{DynamicResource BorderUsual}">
                <StackPanel>
                    <Grid Style="{DynamicResource GridCentered}">
                        <ListBox x:Name="RecordsLB" Style="{DynamicResource ListBoxSmall}" MouseDoubleClick="RecordsLB_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{DynamicResource GridHorizontalAdminPanel}">
                                        <WrapPanel Style="{DynamicResource WrapPanelOrientHor}" ItemHeight="16">
                                            <TextBlock Text="{Binding GamesCategories.Games.name, StringFormat=Игра: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding GamesCategories.Categories.category, StringFormat=Категория: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding total_time, StringFormat=Время: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding date, StringFormat=Дата: dd.MM.yyyy hh:mm:ss}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding GamesPlatforms.Platforms.platform, StringFormat=Платформа: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                            <TextBlock Text="{Binding is_verified, StringFormat=Верифицирован?: {0}}" Style="{DynamicResource RegularAdminPanel}"/>
                                        </WrapPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
