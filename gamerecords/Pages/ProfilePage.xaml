<Page x:Class="gamerecords.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="ProfilePage">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        
        <!--Заголовок-->
        <TextBlock Text="Профиль" Style="{DynamicResource HeaderTextProfile}"/>
        <TextBlock x:Name="NickNameTB" Text="Никнейм: " Style="{DynamicResource HeaderTextProfile}"/>
        <TextBlock Text="Мои рекорды" Style="{DynamicResource HeaderTextProfile}"/>

        <!--Вывод рекордов пользователя-->
        <StackPanel Style="{DynamicResource StackPanelCentered}">
            <Border Style="{DynamicResource BorderUsual}">
                <StackPanel>
                    <Grid Style="{DynamicResource GridCentered}">
                        <ListBox x:Name="RecordsLB" Style="{DynamicResource ListBoxSmall}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{DynamicResource GridHorizontalAdminPanel}">
                                        <WrapPanel Style="{DynamicResource WrapPanelOrientHor}">
                                            <TextBlock Text="{Binding GamesCategories.Games.name, StringFormat=Игра: {0}}" Style="{DynamicResource TextProfile}"/>
                                            <TextBlock Text="{Binding GamesCategories.Categories.category, StringFormat=Категория: {0}}" Style="{DynamicResource TextProfile}"/>
                                            <TextBlock Text="{Binding total_time, StringFormat=Время: {0}}" Style="{DynamicResource TextProfile}"/>
                                            <TextBlock Text="{Binding date, StringFormat=Дата: dd.MM.yyyy hh.mm.ss}" Style="{DynamicResource TextProfile}"/>
                                            <TextBlock Text="{Binding GamesPlatforms.Platforms.platform, StringFormat=Платформа: {0}}" Style="{DynamicResource TextProfile}"/>
                                            <TextBlock Text="{Binding is_verified, StringFormat=Верифицирован?: {0}}" Style="{DynamicResource TextProfile}"/>
                                        </WrapPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
