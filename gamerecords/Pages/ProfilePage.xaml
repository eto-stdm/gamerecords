<Page x:Class="gamerecords.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="ProfilePage">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Профиль" HorizontalAlignment="Center" Foreground="White"/>
        <TextBlock x:Name="NickNameTB" Text="Никнейм: " HorizontalAlignment="Center" Foreground="White"/>
        <TextBlock Text="Мои рекорды" HorizontalAlignment="Center" Foreground="White"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Padding="10" Background="#233a3d" CornerRadius="10">
                <StackPanel>
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                        <ListBox x:Name="RecordsLB" Width="730" Height="400" Background="#233a3d" BorderBrush="#233a3d" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Grid.ColumnSpan="2">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="700" Height="60" Margin="5">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GamesCategories.Games.name, StringFormat=Игра: {0}}" Foreground="White" TextWrapping="Wrap" Margin="0,10,10,0"/>
                                            <TextBlock Text="{Binding GamesCategories.Categories.category, StringFormat=Категория: {0}}" Foreground="White" TextWrapping="Wrap" Margin="0,10,10,0"/>
                                            <TextBlock Text="{Binding total_time, StringFormat=Время: {0}}" Foreground="White" TextWrapping="Wrap" Margin="0,10,10,0"/>
                                            <TextBlock Text="{Binding date, StringFormat=Дата: dd.MM.yyyy hh.mm.ss}" Foreground="White" TextWrapping="Wrap" Margin="0,10,10,0"/>
                                            <TextBlock Text="{Binding GamesPlatforms.Platforms.platform, StringFormat=Платформа: {0}}" Foreground="White" TextWrapping="Wrap" Margin="0,10,10,0"/>
                                            <TextBlock Text="{Binding is_verified, StringFormat=Верифицирован?: {0}}" Foreground="White" TextWrapping="Wrap" Margin="0,10,10,0"/>
                                        </WrapPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
