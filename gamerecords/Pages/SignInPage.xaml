<Page x:Class="gamerecords.Pages.SignInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignInPage">

    <StackPanel Style="{DynamicResource StackPanelCentered}">
        <Image Style="{DynamicResource LogoSignIn}"/>
        <Border Style="{DynamicResource BorderUsual}">
            
            <StackPanel>
                
                <!--Заголовок-->
                <TextBlock Text="Вход" Style="{DynamicResource HeaderSignIn}"/>
                
                <!--Логин-->
                <StackPanel Style="{DynamicResource StackPanelCentered}">
                    <TextBlock Text="Логин" Style="{DynamicResource RegularTextSignIn}"/>
                    <TextBox x:Name="LoginTB" Style="{DynamicResource TextBoxSignIn}"/>
                </StackPanel>
                
                <StackPanel Style="{DynamicResource StackPanelCentered}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!--Пароль-->
                        <TextBlock Text="Пароль" Grid.Column="0" Style="{DynamicResource RegularTextSignIn}"/>
                        <TextBlock Grid.Column="1" Style="{DynamicResource TextPassSignIn}">
                            <Hyperlink x:Name="ForgotPasswordHL" Style="{DynamicResource HyperlinkSignIn}" Click="ForgotPasswordHL_Click">Забыли пароль?</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <PasswordBox x:Name="PasswordTB" Style="{DynamicResource PasswordSignIn}"/>
                </StackPanel>

                <!--Вход-->
                <Button x:Name="SignInBtn" Content="Войти" Style="{DynamicResource ButtonSignIn}" Click="SignInBtn_Click"/>
                <StackPanel Style="{DynamicResource SPSignIn}">
                    <TextBlock Text="Новые в спидраннинге?" Style="{DynamicResource RegularTextSignIn}"/>
                    <TextBlock Grid.Column="1" Style="{DynamicResource TextNewSignIn}">
                       <Hyperlink x:Name="SignUpHL" Style="{DynamicResource HyperlinkSignIn}" Click="SignUpHL_Click">Создайте аккаунт</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
