<Page x:Class="gamerecords.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="MainPage">

    <Grid Style="{DynamicResource GridMain}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!--Задний фон-->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="8" Style="{DynamicResource BorderMain}"/>

        <!--Панель с кнопками-->
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="6" Style="{DynamicResource StackPanelMain}">
            <Image Style="{DynamicResource LogoMain}"/>
            <Button x:Name="AdminBtn" Content="👨🏽‍💻" Style="{DynamicResource ButtonMenu}" ToolTip="Панель администратора" Click="AdminBtn_Click" Visibility="Collapsed"/>
            <Button x:Name="GamesBtn" Content="🎮" Style="{DynamicResource ButtonMenu}" ToolTip="Каталог игр" Click="GamesBtn_Click"/>
            <TextBox x:Name="SearchTB" Style="{DynamicResource TBMain}" ToolTip="Поисковая строка"/>
            <Button x:Name="SearchBtn" Content="🔍" Style="{DynamicResource SearchBtnMenu}" ToolTip="Кнопка поиска" Click="SearchBtn_Click"/>
            <Button x:Name="ProfileBtn" Content="👤" Style="{DynamicResource ButtonMenu}" ToolTip="Профиль" Click="ProfileBtn_Click"/>
            <Button x:Name="AccountExitBtn" Content="🚪" Style="{DynamicResource ButtonMenu}" ToolTip="Выход из профиля" Click="AccountExitBtn_Click"/>
        </StackPanel>

        <Frame x:Name="MainPageFrame" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="6" Style="{DynamicResource FramePageMain}" Source="/Pages/CatalogPage.xaml"/>
    </Grid>
</Page>
