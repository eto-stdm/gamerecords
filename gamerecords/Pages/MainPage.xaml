<Page x:Class="gamerecords.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="MainPage">

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Background="#188f6e" Panel.ZIndex="50"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Margin="10" Panel.ZIndex="50">
            <Image Style="{DynamicResource LogoMain}"/>
            <Button x:Name="GamesBtn" Content="Игры" Style="{DynamicResource ButtonMenu}" Click="GamesBtn_Click"/>
            <TextBox x:Name="SearchTB" Width="300" Margin="50,0,10,0"/>
            <Button x:Name="SearchBtn" Content="🔍" Width="30" Margin="0,0,50,0" Click="SearchBtn_Click"/>
            <Button x:Name="ProfileBtn" Content="Профиль" Style="{DynamicResource ButtonMenu}" Click="ProfileBtn_Click"/>
        </StackPanel>

        <Frame x:Name="MainPageFrame" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4" NavigationUIVisibility="Hidden" Margin="10" Source="/Pages/CatalogPage.xaml"/>

        </Grid>
</Page>
