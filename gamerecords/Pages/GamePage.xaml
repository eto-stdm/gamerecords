<Page x:Class="gamerecords.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="GamePage">

    <StackPanel Style="{DynamicResource StackPanelCentered}">
        
        <!--Общая информация об игре и кнопки-->
        <Border Style="{DynamicResource BorderGame}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Style="{DynamicResource GameImgBorder}">
                    <Border.Background>
                        <ImageBrush x:Name="GameIB" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="GameNameTB" Grid.Column="1" Grid.Row="0" Style="{DynamicResource FirstHeaderGame}"/>
                <TextBlock x:Name="GameTagsTB" Grid.Column="1" Grid.Row="1" Style="{DynamicResource SecondHeaderGame}"/>
                <Border Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Style="{DynamicResource BorderButtonsGame}">
                    <WrapPanel Style="{DynamicResource WrapPanelOrientHor}">
                        <Button x:Name="GameLeaderboardBtn" Content="Таблицы лидеров" Style="{DynamicResource ButtonMainGame}" Click="ChangeBorder"/>
                        <Button x:Name="GameGuidesBtn" Content="Гайды" Style="{DynamicResource ButtonMainGame}" Click="ChangeBorder"/>
                        <Button x:Name="GameStatsBtn" Content="Статистика" Style="{DynamicResource ButtonMainGame}" Click="ChangeBorder"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <!--Лидерборд-->
        <Border Style="{DynamicResource BorderUsual}" x:Name="GameLeaderboardB" Visibility="Visible">
            <StackPanel>

                <!--Информация по категориям-->
                <Grid Style="{DynamicResource GridCentered}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <!--<RowDefinition Height="50"/>-->
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="CategoryCB" Grid.Column="0"  Style="{DynamicResource ComboBoxLeaderGame}" SelectionChanged="CategoryCB_SelectionChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button x:Name="RulesBtn" Content="Правила" Style="{DynamicResource ButtonRulesLeaderGame}" Click="RulesBtn_Click"/>
                        <Button x:Name="SubmitRunBtn" Content="Опубликовать забег" Style="{DynamicResource ButtonLeaderGame}" Click="SubmitRunBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!--Заголовок либерборда-->
                <Border>
                    <Grid Style="{DynamicResource GridLeaderGame}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Игрок" Style="{DynamicResource TextLeaderGame}"/>
                    <TextBlock Grid.Column="1" Text="Время" Style="{DynamicResource TextLeaderGame}"/>
                    <TextBlock Grid.Column="2" Text="Дата" Style="{DynamicResource TextLeaderGame}"/>
                    <TextBlock Grid.Column="3" Text="Платформа" Style="{DynamicResource TextLeaderGame}"/>
                    </Grid>
                </Border>

                <!--Список рекордов-->
                <ListBox x:Name="LeaderboardLB" Style="{DynamicResource ListBoxLeaderGame}" MouseDoubleClick="LeaderboardLB_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{DynamicResource GridLBGame}" ToolTip="Дважды нажмите для просмотра видео">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Players.nickname}" Style="{DynamicResource TextLeaderGame}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding total_time}" Style="{DynamicResource TextLeaderGame}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding date, StringFormat=dd.MM.yyyy hh.mm.ss}" Style="{DynamicResource TextLeaderGame}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding GamesPlatforms.Platforms.platform}" Style="{DynamicResource TextLeaderGame}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Border>

        <!--Список гайдов-->
        <Border Style="{DynamicResource BorderUsual}" x:Name="GameGuidesB" Visibility="Collapsed">
            <StackPanel>
                <ListBox x:Name="GuidesLB" Style="{DynamicResource ListBoxSmall}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{DynamicResource GridrLBGame}">
                                <StackPanel Style="{DynamicResource SPGuidesGame}">
                                    <TextBlock Text="{Binding title}" Style="{DynamicResource TextLeaderGame}"/>
                                    <TextBlock Text="{Binding Players.nickname}" Style="{DynamicResource TextLeaderGame}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Border>

        <!--Статистика-->
        <Border Style="{DynamicResource BorderUsual}" x:Name="GameStatsB" Visibility="Collapsed">
        </Border>
    </StackPanel>
</Page>
