<Page x:Class="gamerecords.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="GamePage">

    <StackPanel Style="{DynamicResource StackPanelCentered}">
        
        <!--Общая информация об игре и кнопки-->
        <Border Style="{DynamicResource BorderGame}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Style="{DynamicResource GameImgBorder}">
                    <Border.Background>
                        <ImageBrush x:Name="GameIB" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Button Grid.Row="0" Grid.Column="1" x:Name="GoBackBtn" Content="←" Style="{DynamicResource ButtonBackGame}" Click="GoBackBtn_Click"/>
                <TextBlock x:Name="GameNameTB" Grid.Column="1" Grid.Row="0" Style="{DynamicResource FirstHeaderGame}"/>
                <ListBox x:Name="GameTagsTB" Grid.Column="1" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" BorderBrush="#233a3d" Background="#233a3d">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,0,0,0">
                                <Border Background="#188f6e" CornerRadius="5">
                                    <TextBlock Style="{DynamicResource TextBlockBaseRegular}" Text="{Binding}" Padding="5"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                
                <Border Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Style="{DynamicResource BorderButtonsGame}">
                    <WrapPanel Style="{DynamicResource WrapPanelOrientHor}">
                        <Button x:Name="GameLeaderboardBtn" Content="Таблицы лидеров" Style="{DynamicResource ButtonMainGame}" Click="ChangeBorder"/>
                        <Button x:Name="GameGuidesBtn" Content="Гайды" Style="{DynamicResource ButtonMainGame}" Click="ChangeBorder"/>
                        <Button x:Name="GameStatsBtn" Content="Статистика" Style="{DynamicResource ButtonMainGame}" Click="ChangeBorder"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <!--Лидерборд-->
        <Border Style="{DynamicResource BorderUsual}" x:Name="GameLeaderboardB" Visibility="Collapsed">
            <StackPanel>

                <!--Информация по категориям-->
                <Grid Style="{DynamicResource GridCentered}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="CategoryCB" Grid.Column="0" Style="{DynamicResource ComboBoxLeaderGame}" SelectionChanged="CategoryCB_SelectionChanged"/>
                    <StackPanel Grid.Column="1" Style="{DynamicResource SPMainGame}">
                        <Button x:Name="RulesBtn" Content="Правила" Style="{DynamicResource ButtonRulesLeaderGame}" Click="RulesBtn_Click"/>
                        <Button x:Name="SubmitRunBtn" Content="Опубликовать забег" Style="{DynamicResource ButtonLeaderGame}" Click="SubmitRunBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!--Заголовок либерборда-->
                <Border>
                    <Grid Style="{DynamicResource GridLeaderGame}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Игрок" Style="{DynamicResource TextLeaderGame}"/>
                    <TextBlock Grid.Column="1" Text="Время" Style="{DynamicResource TextLeaderGame}"/>
                    <TextBlock Grid.Column="2" Text="Дата" Style="{DynamicResource TextLeaderGame}"/>
                    <TextBlock Grid.Column="3" Text="Платформа" Style="{DynamicResource TextLeaderGame}"/>
                    </Grid>
                </Border>

                <!--Список рекордов-->
                <ListBox x:Name="LeaderboardLB" Style="{DynamicResource ListBoxLeaderGame}" MouseDoubleClick="LeaderboardLB_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{DynamicResource GridLBGame}" ToolTip="Дважды нажмите для просмотра видео">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Players.nickname}" Style="{DynamicResource TextLeaderGame}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding total_time}" Style="{DynamicResource TextLeaderGame}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding date, StringFormat=dd.MM.yyyy hh:mm:ss}" Style="{DynamicResource TextLeaderGame}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding GamesPlatforms.Platforms.platform}" Style="{DynamicResource TextLeaderGame}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Border>

        <!--Список гайдов-->
        <Border Style="{DynamicResource BorderUsual}" x:Name="GameGuidesB" Visibility="Collapsed">
            <StackPanel>
                <!--Заголовок гайдов-->
                <StackPanel>
                    <Grid Style="{DynamicResource GridCentered}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="CreateGuideBtn" Grid.Column="3" Content="Создать гайд" Style="{DynamicResource ButtonLeaderGame}" Click="CreateGuideBtn_Click"/>
                    </Grid>

                    <Grid Style="{DynamicResource GridLeaderGame}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="Название" Style="{DynamicResource TextLeaderGame}"/>
                        <TextBlock Grid.Column="3" Text="Игрок" Style="{DynamicResource TextLeaderGame}"/>
                    </Grid>
                </StackPanel>
                <ListBox x:Name="GuidesLB" Style="{DynamicResource ListBoxLeaderGame}" MouseDoubleClick="GuidesLB_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{DynamicResource GridLBGame}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding title}" Style="{DynamicResource TextLeaderGame}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Players.nickname}" Style="{DynamicResource TextLeaderGame}" Margin="30,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Border>

        <!--Статистика-->
        <Border Style="{DynamicResource BorderUsual}" x:Name="GameStatsB" Visibility="Collapsed">
            <StackPanel>
                <!--Текстовая статистика-->
                <StackPanel>
                    <TextBlock x:Name="StatTotalRunsTB" Text="Общее число забегов: " Style="{DynamicResource SecondHeaderGame}"/>
                    <TextBlock x:Name="StatTotalTimeTB" Text="Общее время забегов: " Style="{DynamicResource SecondHeaderGame}"/>
                    <TextBlock x:Name="StatTotalPlayersTB" Text="Количество игроков: " Style="{DynamicResource SecondHeaderGame}"/>
                    <TextBlock x:Name="StatTotalGuidesTB" Text="Количество гайдов: " Style="{DynamicResource SecondHeaderGame}"/>
                </StackPanel>

                <!--График-->
                <StackPanel>
                    <WindowsFormsHost Style="{DynamicResource ChartGame}">
                        <charts:Chart x:Name="StatChart">
                            <charts:Chart.Legends>
                                <charts:Legend>
                                </charts:Legend>
                            </charts:Chart.Legends>
                        </charts:Chart>
                    </WindowsFormsHost>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
