<Page x:Class="gamerecords.Pages.SubmitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gamerecords.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="SubmitPage">

    <!--Блок-->
    <StackPanel Style="{DynamicResource StackPanelCentered}">
        <Border Style="{DynamicResource BorderUsual}">
            <Grid Style="{DynamicResource GridSubmit}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!--Строка 1-->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Опубликовать забег" Style="{DynamicResource FirstTBSubmit}"/>

                <!--Строка 2-->
                <StackPanel Grid.Row="1" Grid.Column="0" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="Категоризация" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <TextBlock Text="Определяет, в каком лидерборде будет находиться забег" Style="{DynamicResource OtherSPTBSubmit}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="Категория *" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <ComboBox x:Name="CategoryCB" Style="{DynamicResource CBSubmit}"/>
                </StackPanel>

                <!--Строка 3-->
                <StackPanel Grid.Row="2" Grid.Column="0" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="Время забега" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <TextBlock Text="Определяет положение забега в лидерборде" Style="{DynamicResource OtherSPTBSubmit}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="Время *" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <TextBox x:Name="TimeTB" Style="{DynamicResource TimeTBSubmit}"/>
                </StackPanel>

                <!--Строка 4-->
                <StackPanel Grid.Row="3" Grid.Column="0" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="Дата забега" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <TextBlock Text="Когда был совершён забег?" Style="{DynamicResource OtherSPTBSubmit}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="Дата и время *" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <StackPanel Style="{DynamicResource StackPanelOrientHor}">
                        <RadioButton x:Name="JustFinishedRB" GroupName="DateTimeGN" Content="Только что" Style="{DynamicResource RBSubmit}" Checked="JustFinishedRB_Checked"/>
                        <RadioButton x:Name="CustomRB" GroupName="DateTimeGN" Content="Кастомное" Style="{DynamicResource RBSubmit}" Checked="CustomRB_Checked"/>
                        <StackPanel x:Name="DateTimeSP" Style="{DynamicResource StackPanelOrientHor}" Visibility="Collapsed">
                            <DatePicker x:Name="DateTimeDP" Style="{DynamicResource DPSubmit}"/>
                            <TextBox x:Name="DateTimeTB" Style="{DynamicResource TimeTBSubmit}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--Строка 5-->
                <StackPanel Grid.Row="4" Grid.Column="0" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="Видео" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <TextBlock Text="Модераторы этой игры требуют видеодоказательство для верификации забега" Style="{DynamicResource OtherSPTBSubmit}"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="URL видео *" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <TextBox x:Name="VideoTB" Style="{DynamicResource VideoTBSubmit}"/>
                </StackPanel>
                
                <!--Строка 6-->
                <StackPanel Grid.Row="5" Grid.Column="0" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="Другое" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <TextBlock Text="Эти значения не влияют на положение в лидерборде" Style="{DynamicResource OtherSPTBSubmit}"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Style="{DynamicResource SPSubmit}">
                    <TextBlock Text="Платформа *" Style="{DynamicResource FirstSPTBSubmit}"/>
                    <ComboBox x:Name="PlatformCB" Style="{DynamicResource CBSubmit}"/>
                </StackPanel>

                <!--Строка 7-->
                <StackPanel Grid.Row="6" Grid.Column="1" Style="{DynamicResource SPSubmit}">
                    <Button x:Name="SubmitRunBtn" Content="Опубликовать" Style="{DynamicResource ButtonSubmit}" Click="SubmitRunBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Page>
