<Window x:Class="gamerecords.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gamerecords"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowStyle="None"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        Height="1080" Width="1920"
        Style="{DynamicResource MyWindowStyle}">

    <!--Кнопки поверх всего-->
    <Grid>
        <StackPanel Style="{DynamicResource SPMain}">
            <TextBlock Text="Смена темы:" Style="{DynamicResource RegularTextMain}"/>
            <ComboBox x:Name="ChooseThemeCB" Style="{DynamicResource ComboBoxTheme}" SelectionChanged="ChooseThemeCB_SelectionChanged"/>
        </StackPanel>

        <Button x:Name="CloseBtn" Content="✗" Style="{DynamicResource ButtonExit}" Click="CloseBtn_Click"/>
        <Frame x:Name="MainFrame" Style="{DynamicResource FrameMain}" Source="Pages/SignInPage.xaml"/>
        <TextBlock x:Name="DateTimeNow" Style="{DynamicResource ClockMain}"/>
    </Grid>
</Window>
