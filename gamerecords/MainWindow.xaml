<Window x:Class="gamerecords.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gamerecords"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowStyle="None"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        
        Style="{DynamicResource MyWindowStyle}">
    <Grid>
        <StackPanel Orientation="Horizontal" Panel.ZIndex="100" VerticalAlignment="Top" HorizontalAlignment="Left">
            <TextBlock Text="Смена темы:" Style="{DynamicResource RegularTextMain}"/>
            <ComboBox x:Name="ChooseThemeCB" Style="{DynamicResource ComboBoxTheme}" SelectionChanged="ChooseThemeCB_SelectionChanged"/>
        </StackPanel>

        <Button x:Name="CloseBtn" Panel.ZIndex="100" Content="✗" Style="{DynamicResource ButtonExit}" Click="CloseBtn_Click"/>
        <Frame x:Name="MainFrame" Source="Pages/SignInPage.xaml" NavigationUIVisibility="Hidden"/>
        <TextBlock x:Name="DateTimeNow" Panel.ZIndex="100" Style="{DynamicResource ClockMain}"/>
    </Grid>
</Window>
