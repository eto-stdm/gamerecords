<Window x:Class="gamerecords.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gamerecords"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowStyle="None"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Style="{StaticResource MyWindowStyle}">
    <Grid>
        <Button x:Name="CloseBtn" Content="✗" Style="{StaticResource ButtonExit}" Click="CloseBtn_Click"/>
        <Frame Source="Pages/SignInPage.xaml" NavigationUIVisibility="Hidden"/>
        <TextBlock x:Name="DateTimeNow" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Foreground="White"/>
    </Grid>
</Window>
