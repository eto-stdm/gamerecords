<Window x:Class="gamerecords.Dialogs.CaptchaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gamerecords.Dialogs"
        mc:Ignorable="d"
        Title="CaptchaDialog"
        Closing="Window_Closing"
        Height="200" Width="200">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Введите капчу:" FontSize="20" Margin="10, 10, 10, 10" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CaptchaTB" Text="Капча" FontSize="20" HorizontalAlignment="Center" Margin="10, 0, 10, 10"/>
            <TextBox x:Name="EnterCaptchaTB" Margin="10, 0, 10, 10"/>
            <Button x:Name="CheckCaptchaB" Content="Ввести" Width="60" Margin="10, 0, 10, 10" Click="CheckCaptchaB_Click"/>
        </StackPanel>
    </Grid>
</Window>
