<Window x:Class="gamerecords.Dialogs.CaptchaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gamerecords.Dialogs"
        mc:Ignorable="d"
        Title="CaptchaDialog"
        Closing="Window_Closing"
        WindowStartupLocation="CenterOwner"
        Height="200" Width="200">

    <StackPanel Style="{DynamicResource StackPanelCentered}">
        <TextBlock Text="Введите капчу:" Style="{DynamicResource FirstTextCaptcha}"/>
        <TextBlock x:Name="CaptchaTB" Text="Капча" Style="{DynamicResource OtherTextCaptcha}"/>
        <TextBox x:Name="EnterCaptchaTB" Style="{DynamicResource TextBoxCaptcha}"/>
        <Button x:Name="CheckCaptchaB" Content="Ввести" Style="{DynamicResource ButtonCaptcha}" Click="CheckCaptchaB_Click"/>
    </StackPanel>
</Window>
