<Window x:Class="gamerecords.Dialogs.GuidesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gamerecords.Dialogs"
        mc:Ignorable="d"
        Title="Гайд"
        Height="450" Width="800"
        Style="{DynamicResource MyWindowStyle}">
    
    <Grid>
        <ScrollViewer Style="{DynamicResource SVRules}">
            <StackPanel>
                <TextBlock x:Name="HeaderGuideTB" Text="Гайд: " Style="{DynamicResource HeaderTextRules}"/>
                <TextBlock x:Name="TextGuideTB" Style="{DynamicResource RegularTextRules}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
