<Window x:Class="gamerecords.Dialogs.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gamerecords.Dialogs"
        mc:Ignorable="d"
        Title="ExitDialog" Height="200" Width="250">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Вы действительно хотите выйти?" FontSize="20" Margin="10, 10, 10, 10" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="YesBtn" Content="Да" Width="60" Margin="10, 0, 10, 10" Click="YesBtn_Click"/>
            <Button x:Name="NoBtn" Content="Нет" Width="60" Margin="10, 0, 10, 10" Click="NoBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
